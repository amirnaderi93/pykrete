/target
**/*.rs.bk
.DS_Store
Cargo.lock.bak

# Local/dev-environment files — never commit
.cargo/config.toml
.claude/settings.local.json

# VS Code extension build artifacts (npm-installed deps, tsc output,
# packaged VSIX bundles). The source files under editors/*/ are tracked.
editors/*/node_modules/
editors/*/out/
editors/*/*.vsix

# Claude Code scheduling lockfiles (per-session, not source-controlled)
.claude/scheduled_tasks.lock

# Per-user VS Code workspace settings (interpreter paths, etc.)
.vscode/
examples/dathon.py
