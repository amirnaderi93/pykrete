/target
**/*.rs.bk
.DS_Store
Cargo.lock.bak

# Local/dev-environment files — never commit
.cargo/config.toml
.claude/settings.local.json

# Claude Code multi-agent setup — local-only for now (TM/developer/reviewer
# subagents + project CLAUDE.md describing the workflow).
.claude/agents/
CLAUDE.md

# VS Code extension build artifacts (npm-installed deps, tsc output,
# packaged VSIX bundles, the platform-specific pykrete-lsp binary the
# release workflow drops in for vsce package). The source files under
# editors/*/ are tracked.
editors/*/node_modules/
editors/*/out/
editors/*/*.vsix
editors/vscode/server/

# Claude Code scheduling lockfiles (per-session, not source-controlled)
.claude/scheduled_tasks.lock

# Local Claude Code auto-memory (per-project, never committed).
# Physically lives in project tree for portability; ~/.claude/projects/.../memory
# symlinks here. Run .claude/setup-memory-symlink.sh on a fresh machine.
.claude/memory/

# Per-user VS Code workspace settings (interpreter paths, etc.)
.vscode/
examples/pykrete.py

# Quarto preview output for any tracked Markdown file (README.html +
# its sibling assets directory).
/*.html
/*_files/

# wasm-pack build output for the playground crate. The npm-style
# package (pykrete_wasm.js + pykrete_wasm_bg.wasm + package.json) is
# regenerated by `scripts/build-wasm.sh` — no need to track it.
docs-site/pykrete-wasm-pkg/
