# Nested-struct schemas: a Schema field whose type is another Schema class.
# Models PySpark's StructType columns.
#
# What pykrete recognizes here:
#   - `address: Address` as a nested struct field, where Address is
#     another Schema declared in the same file.
#   - `col("address")` works against the outer schema (top-level field).
#   - `col("address.street")` walks through the nested schema. The
#     diagnostic on a typo points at the inner schema (e.g.
#     "does not exist on schema 'Address'") — closer to where the bug is.

class Address(Schema):
    street: string
    city: string


class GeoPoint(Schema):
    lat: double
    lon: double


# Three-deep nesting works the same way — each level resolves
# independently.
class Place(Schema):
    name: string
    address: Address
    coordinates: GeoPoint


class User(Schema):
    user_id: int
    name: string
    home: Place


def keep_top_level_columns(users: DataFrame[User]) -> DataFrame:
    # Selecting nested-struct columns by their top-level name is supported.
    return users.select(col("user_id"), col("name"), col("home"))


def project_dotted_paths(users: DataFrame[User]) -> DataFrame:
    # Dotted paths walk into nested schemas. All four columns here are
    # valid: home.address resolves to a Place→Address chain; .street is
    # a string field of Address; .coordinates.lat goes three deep.
    return users.select(
        col("user_id"),
        col("home.name"),
        col("home.address.street"),
        col("home.coordinates.lat"),
    )
