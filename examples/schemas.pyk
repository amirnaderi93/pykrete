# Probes schema + field-type + SparkFrame[Schema] + body-level operation checks.

class Orders(Schema):
    place_code: int
    price: int

class RawOrders(Schema):
    ProductCode: int
    UnitPrice: double
    CreatedAt: timestamp

class NotASchema:
    foo: int

class WithMixin(Schema, Mixin):
    field: int

class WithGeneric(Generic[T]):
    pass

class BadSchema(Schema):
    valid_field: int
    unknown_field: WeirdType
    subscripted: list[str]


def prepare_orders(raw: SparkFrame[RawOrders]) -> SparkFrame[Orders]:
    return raw.select(col("ProductCode"), col("UnitPrice"), col("CreatedAt"))


def select_with_typo(raw: SparkFrame[Orders]) -> SparkFrame[Orders]:
    return raw.select(col("place_code"), col("priec"), col("totally_made_up"))


def select_all_valid(raw: SparkFrame[Orders]) -> SparkFrame[Orders]:
    return raw.select(col("place_code"), col("price"))


def select_bare_strings(raw: SparkFrame[Orders]) -> SparkFrame[Orders]:
    return raw.select("place_code", "price")


def select_bare_string_typo(raw: SparkFrame[Orders]) -> SparkFrame[Orders]:
    return raw.select("place_code", "no_such_col")


def filter_with_typo(raw: SparkFrame[Orders]) -> SparkFrame[Orders]:
    return raw.filter((col("price") > 0) & (col("nonexistent") < 100))


def where_with_typo(raw: SparkFrame[RawOrders]) -> SparkFrame[RawOrders]:
    return raw.where(col("UnitPrice").isNotNull() & (col("Bogus") > 0))


def filter_string_value_is_not_a_column(raw: SparkFrame[Orders]) -> SparkFrame[Orders]:
    return raw.filter(col("place_code") == "literal_value")


def expression_with_aliases(raw: SparkFrame[Orders]) -> SparkFrame[Orders]:
    return raw.select(
        col("place_code").alias("pc"),
        (col("price") * col("misspelled")).cast("int").alias("price_adj"),
    )


def drop_bare_string(raw: SparkFrame[Orders]) -> SparkFrame[Orders]:
    return raw.drop("price")


def drop_typo(raw: SparkFrame[Orders]) -> SparkFrame[Orders]:
    return raw.drop("price", "nope")


def drop_duplicates_list(raw: SparkFrame[Orders]) -> SparkFrame[Orders]:
    return raw.dropDuplicates(["place_code", "missing_key"])


def group_by_mixed(raw: SparkFrame[Orders]) -> SparkFrame[Orders]:
    return raw.groupBy("place_code", col("invented"))


def with_column_valid(raw: SparkFrame[Orders]) -> SparkFrame[Orders]:
    return raw.withColumn("price_log", col("price") * 2)


def with_column_typo(raw: SparkFrame[Orders]) -> SparkFrame[Orders]:
    return raw.withColumn("price_log", col("priec") * 2)


def with_column_renamed_valid(raw: SparkFrame[Orders]) -> SparkFrame[Orders]:
    return raw.withColumnRenamed("place_code", "code")


def with_column_renamed_typo(raw: SparkFrame[Orders]) -> SparkFrame[Orders]:
    return raw.withColumnRenamed("place_cdoe", "code")


def union_same_schema(a: SparkFrame[Orders], b: SparkFrame[Orders]) -> SparkFrame[Orders]:
    return a.unionByName(b)


def union_different_schema(a: SparkFrame[Orders], b: SparkFrame[RawOrders]) -> SparkFrame[Orders]:
    return a.unionByName(b)


def union_plain_different(a: SparkFrame[Orders], b: SparkFrame[RawOrders]) -> SparkFrame[Orders]:
    return a.union(b)


def join_on_valid_key(left: SparkFrame[Orders], right: SparkFrame[Orders]) -> SparkFrame:
    return left.join(right, on="place_code")


def join_with_missing_key(left: SparkFrame[Orders], right: SparkFrame[RawOrders]) -> SparkFrame:
    return left.join(right, on="place_code")


def join_then_select_combined_columns(left: SparkFrame[Orders], right: SparkFrame[Orders]) -> SparkFrame:
    return left.join(right, on="place_code").select(col("price"))


def join_then_select_unknown(left: SparkFrame[Orders], right: SparkFrame[Orders]) -> SparkFrame:
    return left.join(right, on="place_code").select(col("madeup"))


def cross_join_combines_both(a: SparkFrame[Orders], b: SparkFrame[Orders]) -> SparkFrame:
    return a.crossJoin(b)


def chained_typo(raw: SparkFrame[Orders]) -> SparkFrame[Orders]:
    return raw.filter(col("price") > 0).select(col("madeup"))


def chained_clean(raw: SparkFrame[Orders]) -> SparkFrame[Orders]:
    return raw.filter(col("price") > 0).select(col("place_code"), col("price"))


def local_binding_typo(raw: SparkFrame[Orders]) -> SparkFrame[Orders]:
    filtered = raw.filter(col("price") > 0)
    return filtered.select(col("place_code"), col("ghost"))


def local_then_partial(raw: SparkFrame[Orders]) -> SparkFrame[Orders]:
    partial = raw.select(col("place_code"))
    return partial.select(col("price"))


def return_partial(raw: SparkFrame[Orders]) -> SparkFrame[Orders]:
    return raw.select(col("place_code"))


def return_extra(raw: SparkFrame[Orders]) -> SparkFrame[Orders]:
    return raw.withColumn("bonus", col("price") * 2)


def return_clean(raw: SparkFrame[Orders]) -> SparkFrame[Orders]:
    return raw.select(col("place_code"), col("price"))


def bad_fn(x: SparkFrame[NotAKnownSchema]) -> SparkFrame[Orders]:
    return x


def weird_fn(y: SparkFrame[list[str]]) -> SparkFrame:
    return y


def no_df_annotations(z: int) -> int:
    return z
