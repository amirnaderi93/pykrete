# Probes class + schema discovery + field-type resolution.

class Orders(Schema):
    place_code: int
    price: int

class RawOrders(Schema):
    ProductCode: int
    UnitPrice: double
    CreatedAt: timestamp

class NotASchema:
    foo: int

class WithMixin(Schema, Mixin):
    field: int

class WithGeneric(Generic[T]):
    pass

class BadSchema(Schema):
    valid_field: int
    unknown_field: WeirdType
    subscripted: list[str]
