# Probes schema + field-type + DataFrame[Schema] + body-level operation checks.

class Orders(Schema):
    place_code: int
    price: int

class RawOrders(Schema):
    ProductCode: int
    UnitPrice: double
    CreatedAt: timestamp

class NotASchema:
    foo: int

class WithMixin(Schema, Mixin):
    field: int

class WithGeneric(Generic[T]):
    pass

class BadSchema(Schema):
    valid_field: int
    unknown_field: WeirdType
    subscripted: list[str]


def prepare_orders(raw: DataFrame[RawOrders]) -> DataFrame[Orders]:
    return raw.select(col("ProductCode"), col("UnitPrice"), col("CreatedAt"))


def select_with_typo(raw: DataFrame[Orders]) -> DataFrame[Orders]:
    return raw.select(col("place_code"), col("priec"), col("totally_made_up"))


def select_all_valid(raw: DataFrame[Orders]) -> DataFrame[Orders]:
    return raw.select(col("place_code"), col("price"))


def select_bare_strings(raw: DataFrame[Orders]) -> DataFrame[Orders]:
    return raw.select("place_code", "price")


def select_bare_string_typo(raw: DataFrame[Orders]) -> DataFrame[Orders]:
    return raw.select("place_code", "no_such_col")


def filter_with_typo(raw: DataFrame[Orders]) -> DataFrame[Orders]:
    return raw.filter((col("price") > 0) & (col("nonexistent") < 100))


def where_with_typo(raw: DataFrame[RawOrders]) -> DataFrame[RawOrders]:
    return raw.where(col("UnitPrice").isNotNull() & (col("Bogus") > 0))


def filter_string_value_is_not_a_column(raw: DataFrame[Orders]) -> DataFrame[Orders]:
    return raw.filter(col("place_code") == "literal_value")


def expression_with_aliases(raw: DataFrame[Orders]) -> DataFrame[Orders]:
    return raw.select(
        col("place_code").alias("pc"),
        (col("price") * col("misspelled")).cast("int").alias("price_adj"),
    )


def drop_bare_string(raw: DataFrame[Orders]) -> DataFrame[Orders]:
    return raw.drop("price")


def drop_typo(raw: DataFrame[Orders]) -> DataFrame[Orders]:
    return raw.drop("price", "nope")


def drop_duplicates_list(raw: DataFrame[Orders]) -> DataFrame[Orders]:
    return raw.dropDuplicates(["place_code", "missing_key"])


def group_by_mixed(raw: DataFrame[Orders]) -> DataFrame[Orders]:
    return raw.groupBy("place_code", col("invented"))


def with_column_valid(raw: DataFrame[Orders]) -> DataFrame[Orders]:
    return raw.withColumn("price_log", col("price") * 2)


def with_column_typo(raw: DataFrame[Orders]) -> DataFrame[Orders]:
    return raw.withColumn("price_log", col("priec") * 2)


def with_column_renamed_valid(raw: DataFrame[Orders]) -> DataFrame[Orders]:
    return raw.withColumnRenamed("place_code", "code")


def with_column_renamed_typo(raw: DataFrame[Orders]) -> DataFrame[Orders]:
    return raw.withColumnRenamed("place_cdoe", "code")


def union_same_schema(a: DataFrame[Orders], b: DataFrame[Orders]) -> DataFrame[Orders]:
    return a.unionByName(b)


def union_different_schema(a: DataFrame[Orders], b: DataFrame[RawOrders]) -> DataFrame[Orders]:
    return a.unionByName(b)


def union_plain_different(a: DataFrame[Orders], b: DataFrame[RawOrders]) -> DataFrame[Orders]:
    return a.union(b)


def bad_fn(x: DataFrame[NotAKnownSchema]) -> DataFrame[Orders]:
    return x


def weird_fn(y: DataFrame[list[str]]) -> DataFrame:
    return y


def no_df_annotations(z: int) -> int:
    return z
