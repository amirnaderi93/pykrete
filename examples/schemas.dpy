# Probes schema + field-type + DataFrame[Schema] + body-level select/filter/where checks.

class Orders(Schema):
    place_code: int
    price: int

class RawOrders(Schema):
    ProductCode: int
    UnitPrice: double
    CreatedAt: timestamp

class NotASchema:
    foo: int

class WithMixin(Schema, Mixin):
    field: int

class WithGeneric(Generic[T]):
    pass

class BadSchema(Schema):
    valid_field: int
    unknown_field: WeirdType
    subscripted: list[str]


def prepare_orders(raw: DataFrame[RawOrders]) -> DataFrame[Orders]:
    return raw.select(col("ProductCode"), col("UnitPrice"), col("CreatedAt"))


def select_with_typo(raw: DataFrame[Orders]) -> DataFrame[Orders]:
    return raw.select(col("place_code"), col("priec"), col("totally_made_up"))


def select_all_valid(raw: DataFrame[Orders]) -> DataFrame[Orders]:
    return raw.select(col("place_code"), col("price"))


def filter_with_typo(raw: DataFrame[Orders]) -> DataFrame[Orders]:
    return raw.filter((col("price") > 0) & (col("nonexistent") < 100))


def where_with_typo(raw: DataFrame[RawOrders]) -> DataFrame[RawOrders]:
    return raw.where(col("UnitPrice").isNotNull() & (col("Bogus") > 0))


def expression_with_aliases(raw: DataFrame[Orders]) -> DataFrame[Orders]:
    return raw.select(
        col("place_code").alias("pc"),
        (col("price") * col("misspelled")).cast("int").alias("price_adj"),
    )


def bad_fn(x: DataFrame[NotAKnownSchema]) -> DataFrame[Orders]:
    return x


def weird_fn(y: DataFrame[list[str]]) -> DataFrame:
    return y


def no_df_annotations(z: int) -> int:
    return z
